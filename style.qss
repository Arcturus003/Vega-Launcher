/* ==========================================================================
   Vega Launcher Design System — Obsidian Void & Cyber-Ender Visual Language
   Palette:
     - Base Window (Void): #08090F
     - Panel / Rail Surface: #0C0D16
     - Solid Card Surface: #111322
     - Elevated Obsidian / Modal: #16192C
     - Obsidian Borders: rgba(139, 92, 246, 0.18) / #242436
     - Primary Accent: #8B5CF6 / #A855F7 (themeable)
     - Secondary Accent (Ender Eye): #06B6D4 / #22D3EE
     - 3D Bevel Top: #A78BFA
     - 3D Bevel Bottom: #4C1D95
     - Headings/Labels: #F8FAFC / Subtitle: #CBD5E1 / Muted: #94A3B8
   ========================================================================== */

QMainWindow {
    background-color: #08090F;
}

QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    color: #F8FAFC;
    font-size: 13px;
}

QLabel {
    background: transparent;
    border: none;
}

/* --- Left Navigation Rail --- */
#NavBar {
    background-color: #0C0D16;
    border-right: 1px solid rgba(139, 92, 246, 0.18);
}

#NavButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 9px 14px;
    font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-align: left;
    color: #94A3B8;
    border-radius: 8px;
    margin: 3px 6px;
}

#NavButton:hover {
    color: #F8FAFC;
    background-color: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.28);
}

#NavButton[active="true"] {
    color: #FFFFFF;
    background-color: #1A172C;
    border: 1px solid #8B5CF6;
    border-top: 1.5px solid #A78BFA;
    border-bottom: 2.5px solid #4C1D95;
    border-left: 1.5px solid #8B5CF6;
    border-right: 1.5px solid #6D28D9;
}

/* --- Bottom Command Deck / Action Bar --- */
#ActionBar {
    background-color: #0A0B13;
    border-top: 1px solid rgba(139, 92, 246, 0.22);
    padding: 8px 18px;
}

#PlayButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7C3AED, stop: 0.55 #8B5CF6, stop: 1 #06B6D4);
    color: #FFFFFF;
    font-family: "Minecraft Five", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.5px;
    border-radius: 8px;
    padding: 10px 36px;
    border-top: 1.5px solid #A78BFA;
    border-left: 1.5px solid #8B5CF6;
    border-right: 1.5px solid #06B6D4;
    border-bottom: 3.5px solid #4C1D95;
}

#PlayButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8B5CF6, stop: 0.55 #A855F7, stop: 1 #22D3EE);
    border-top: 1.5px solid #C084FC;
    border-bottom: 3.5px solid #5B21B6;
}

#PlayButton:pressed {
    background: #6D28D9;
    border-top: 2.5px solid #4C1D95;
    border-bottom: 1.5px solid #4C1D95;
    padding-top: 11px;
    padding-bottom: 9px;
}

#PlayButton:disabled {
    background: #1A1A24;
    color: #64748B;
    border: 1px solid #2E2E38;
    border-top: 1.5px solid #343442;
    border-bottom: 3px solid #14141C;
}

/* --- Profiles & Cards List --- */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    background-color: #111322;
    border-radius: 8px;
    margin-bottom: 8px;
    padding: 8px;
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-top: 1px solid rgba(139, 92, 246, 0.28);
    border-bottom: 2px solid #08090F;
}

QListWidget::item:hover {
    background-color: #16192C;
    border: 1px solid rgba(168, 85, 247, 0.55);
    border-top: 1px solid rgba(192, 132, 252, 0.65);
    border-bottom: 2px solid #08090F;
}

QListWidget::item:selected {
    background-color: #1E1A34;
    border: 1.5px solid #C084FC;
}

QListWidget#ProfileList::item {
    padding: 0px;
}

#ModpackCard {
    background-color: #111322;
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-top: 1px solid rgba(139, 92, 246, 0.28);
    border-bottom: 2px solid #08090F;
    border-radius: 10px;
}

#ModpackCard:hover, #ModpackCard[hovered="true"] {
    background-color: #16192C;
    border: 1.5px solid #C084FC;
}

#ModpackCard[selected="true"] {
    background-color: #1E1A34;
    border: 2px solid #C084FC;
}

#CardTitle {
    font-size: 14px;
    font-weight: 700;
    color: #F8FAFC;
    background: transparent;
    border: none;
}

#CardSubtitle {
    font-size: 12px;
    color: #CBD5E1;
    line-height: 1.35;
    background: transparent;
    border: none;
}

/* --- Right Slide-out Detail Panel --- */
#DetailPanel {
    background-color: #0D0F1B;
    border-left: 1px solid rgba(139, 92, 246, 0.25);
}

/* --- Form Inputs & Controls --- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #111322;
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 6px;
    padding: 8px 12px;
    color: #F8FAFC;
    font-size: 13px;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border: 1px solid rgba(139, 92, 246, 0.55);
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #A855F7;
    background-color: #16192C;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #0E101C;
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 6px;
    selection-background-color: rgba(139, 92, 246, 0.35);
    selection-color: #FFFFFF;
    color: #F8FAFC;
    padding: 4px;
    outline: 0px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(139, 92, 246, 0.25);
    color: #FFFFFF;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

/* --- Buttons --- */
QPushButton {
    background-color: #16192C;
    color: #F8FAFC;
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #201D38;
    border: 1px solid #A855F7;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #121022;
}

/* --- Slim Minimalist Scrollbars --- */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    border: none;
    background: rgba(8, 9, 15, 0.5);
    width: 6px;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(139, 92, 246, 0.35);
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #A855F7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* --- Progress Bars --- */
QProgressBar {
    background-color: #0C0D16;
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 4px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7C3AED, stop: 0.6 #A855F7, stop: 1 #06B6D4);
    border-radius: 3px;
}

/* --- Context Menus & Dialogs --- */
QDialog {
    background-color: #0E101C;
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 10px;
}

QMenu {
    background-color: #0E101C;
    color: #F8FAFC;
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-top: 1px solid rgba(139, 92, 246, 0.38);
    border-bottom: 2px solid #08090F;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: rgba(139, 92, 246, 0.25);
    color: #E9D5FF;
}

/* --- Tab Widget Styling (Installed Mods & Server) --- */
QTabWidget::pane {
    border: 1px solid rgba(139, 92, 246, 0.2);
    background: transparent;
    border-radius: 8px;
}

QTabBar::tab {
    background: #111322;
    color: #94A3B8;
    padding: 9px 18px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #F8FAFC;
    background: #16192C;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    background: #1E1A34;
    border-bottom: 2px solid #A855F7;
}

/* --- SubTab Buttons (Installed Mods Panel) --- */
#SubTabButton {
    background-color: #111322;
    color: #94A3B8;
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 14px;
}

#SubTabButton:hover {
    color: #F8FAFC;
    background-color: #16192C;
    border-color: rgba(168, 85, 247, 0.4);
}

#SubTabButton[active="true"] {
    background-color: #1E1A34;
    color: #FFFFFF;
    border: 1px solid #A855F7;
    font-weight: bold;
}

/* --- Settings Cards & Header --- */
QFrame#SettingsCard {
    background-color: #111322;
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-top: 1px solid rgba(139, 92, 246, 0.28);
    border-bottom: 2px solid #08090F;
    border-radius: 8px;
}

QLabel#SettingsCardHeader {
    font-family: 'Minecraft Five', 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #C084FC;
    letter-spacing: 0.8px;
    background: transparent;
    border: none;
}

/* --- De-emphasized Form Field Labels --- */
QLabel#FormLabel, QLabel.FormLabel {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
    border: none;
}

/* --- Primary Accent Action Buttons --- */
QPushButton#PrimaryAccentButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7C3AED, stop: 1 #8B5CF6);
    color: white;
    border-top: 1.5px solid #A78BFA;
    border-bottom: 2.5px solid #4C1D95;
    border-left: 1px solid #8B5CF6;
    border-right: 1px solid #6D28D9;
    border-radius: 6px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#PrimaryAccentButton:hover {
    background-color: #8B5CF6;
    border-top: 1.5px solid #C084FC;
}

QPushButton#PrimaryAccentButton:pressed {
    background-color: #6D28D9;
    padding-top: 10px;
    padding-bottom: 8px;
}

/* --- Secondary Outline Action Buttons --- */
QPushButton#SecondaryOutlineButton {
    background-color: #16192C;
    color: #CBD5E1;
    font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 16px;
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-top: 1.5px solid rgba(139, 92, 246, 0.35);
    border-bottom: 2.5px solid #08090F;
}

QPushButton#SecondaryOutlineButton:hover {
    background-color: #201D38;
    border: 1px solid #A855F7;
    color: #FFFFFF;
}

QPushButton#DestructiveOutlineButton {
    background-color: #16192C;
    color: #CBD5E1;
    font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 600;
    border-radius: 6px;
    padding: 8px 16px;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-top: 1.5px solid rgba(248, 113, 113, 0.4);
    border-bottom: 2.5px solid #08090F;
}

QPushButton#DestructiveOutlineButton:hover {
    background-color: rgba(239, 68, 68, 0.15);
    border: 1px solid #EF4444;
    border-top: 1.5px solid #F87171;
    border-bottom: 2.5px solid #7F1D1D;
    color: #FCA5A5;
}

/* --- Server Side Tabs --- */
#ServerSideTabs {
    background: transparent;
    border: none;
    outline: none;
    padding: 0px;
    font-size: 14px;
    font-weight: 600;
}

#ServerSideTabs::item {
    background-color: transparent;
    border: none;
    padding: 8px 16px;
    color: #94A3B8;
    border-radius: 6px;
    margin: 4px 0px;
}

#ServerSideTabs::item:hover {
    color: #F8FAFC;
    background-color: rgba(139, 92, 246, 0.12);
}

#ServerSideTabs::item:selected {
    color: #FFFFFF;
    background-color: #1A172C;
    border-left: 3px solid #A855F7;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

/* --- Server Summary Cards --- */
QFrame#ServerSummaryCard {
    background-color: #111322;
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 8px;
}

QFrame#ServerSummaryCard:hover {
    background-color: #16192C;
    border: 1.5px solid #A855F7;
}

/* --- CheckBoxes --- */
QCheckBox {
    color: #F8FAFC;
    font-size: 13px;
    font-weight: 600;
    spacing: 8px;
    background: transparent;
}

QCheckBox:hover {
    color: #FFFFFF;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid rgba(139, 92, 246, 0.3);
    background: #111322;
}

QCheckBox::indicator:hover {
    border: 1px solid #A855F7;
    background: #16192C;
}

QCheckBox::indicator:checked {
    background-color: #7C3AED;
    border-top: 1px solid #A78BFA;
    border-bottom: 2px solid #4C1D95;
    border-left: 1px solid #8B5CF6;
    border-right: 1px solid #6D28D9;
    image: url(assets/check.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #8B5CF6;
}

/* ==========================================================================
   Obsidian Profiles & Showcase Selectors
   ========================================================================== */

#HeroCard, QFrame#HeroCard {
    background-color: #111322;
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-top: 1.5px solid rgba(139, 92, 246, 0.35);
    border-bottom: 2.5px solid #08090F;
    border-radius: 10px;
}

QPushButton#HeroActionBtn {
    background-color: #16192C;
    color: #CBD5E1;
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-top: 1.5px solid rgba(139, 92, 246, 0.35);
    border-bottom: 2.5px solid #08090F;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#HeroActionBtn:hover {
    background-color: #201D38;
    border: 1px solid #A855F7;
    color: #FFFFFF;
}

QPushButton#HeroActionBtn:pressed {
    background-color: #121022;
    border-top: 2px solid #08090F;
    border-bottom: 1px solid rgba(139, 92, 246, 0.35);
    padding-top: 8px;
    padding-bottom: 6px;
}

QPushButton#HeroActionBtn:disabled {
    background-color: #111322;
    color: #475569;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#AddProfileBtn {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7C3AED, stop: 1 #8B5CF6);
    color: #FFFFFF;
    border: 1px solid #6D28D9;
    border-top: 1.5px solid #A78BFA;
    border-left: 1.5px solid #8B5CF6;
    border-right: 1.5px solid #6D28D9;
    border-bottom: 3px solid #4C1D95;
    border-radius: 6px;
    padding: 7px 18px;
    font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton#AddProfileBtn:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8B5CF6, stop: 1 #A855F7);
    border-top: 1.5px solid #C084FC;
}

QPushButton#AddProfileBtn:pressed {
    background-color: #6D28D9;
    border-top: 2.5px solid #4C1D95;
    border-bottom: 1px solid #A78BFA;
    padding-top: 9px;
    padding-bottom: 5px;
}

QPushButton#InstallFileBtn {
    background-color: #16192C;
    color: #CBD5E1;
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-top: 1.5px solid rgba(139, 92, 246, 0.35);
    border-bottom: 2.5px solid #08090F;
    border-radius: 6px;
    padding: 7px 18px;
    font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QPushButton#InstallFileBtn:hover {
    background-color: #201D38;
    border: 1px solid #A855F7;
    color: #FFFFFF;
}

QPushButton#InstallFileBtn:pressed {
    background-color: #121022;
    border-top: 2px solid #08090F;
    border-bottom: 1px solid rgba(139, 92, 246, 0.35);
    padding-top: 8px;
    padding-bottom: 6px;
}

QLineEdit#ProfileSearch {
    background-color: #111322;
    color: #F8FAFC;
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 12px;
    selection-background-color: #8B5CF6;
    selection-color: #FFFFFF;
}

QLineEdit#ProfileSearch:hover {
    border: 1px solid rgba(139, 92, 246, 0.55);
}

QLineEdit#ProfileSearch:focus {
    border: 1px solid #A855F7;
    background-color: #16192C;
}

/* --- Installed Mods Panel & Engine Installer --- */
QWidget#InstalledModsPanel, QFrame#InstalledModsPanel {
    background-color: transparent;
}

QPushButton#InstallEngineBtn {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7C3AED, stop: 1 #8B5CF6);
    color: #FFFFFF;
    border: 1px solid #6D28D9;
    border-top: 1.5px solid #A78BFA;
    border-left: 1.5px solid #8B5CF6;
    border-right: 1.5px solid #6D28D9;
    border-bottom: 2.5px solid #4C1D95;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#InstallEngineBtn:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8B5CF6, stop: 1 #A855F7);
    border-top: 1.5px solid #C084FC;
}

QPushButton#InstallEngineBtn:pressed {
    background-color: #6D28D9;
    border-top: 2px solid #4C1D95;
    border-bottom: 1px solid #A78BFA;
    padding-top: 7px;
    padding-bottom: 5px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #0A0B13;
    color: #94A3B8;
    border-top: 1px solid rgba(139, 92, 246, 0.18);
    font-size: 11px;
}

